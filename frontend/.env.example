# Copie para .env.local. Endereço do backend do Bizu.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Mesmo GOOGLE_CLIENT_ID usado no backend (Google Cloud > Credenciais > ID do cliente OAuth, tipo Web).
# Em "Origens JavaScript autorizadas" cadastre http://localhost:3000.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
